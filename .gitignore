# =============================================================================
# .gitignore — RustyNES
# (negations `!` must follow the broad rule they re-include — order matters)
# =============================================================================

# --- Rust / Cargo ---
/target/
/target/doc/
/target/criterion/
# Nested per-crate target/ dirs (build output; the root /target/ rule is anchored).
crates/*/target/
**/*.rs.bk
*.bench
# This workspace ships a binary app — commit the lock (re-include it).
#
# `Cargo.lock` with no slash matches at ANY depth, so the re-include below has
# to name every lockfile we keep. That was written when there was exactly one.
# `crates/rustynes-cosim` is EXCLUDED from the workspace, so it resolves its own
# dependency graph into its own lockfile — which this rule was silently
# ignoring, leaving CI to re-resolve it on every run. That crate emits the
# goldens an external NES implementation is verified against, and its manifest
# records the emulator version, not the resolve, so a dependency moving under it
# would be invisible in exactly the artifact meant to establish provenance.
Cargo.lock
!/Cargo.lock
!/crates/rustynes-cosim/Cargo.lock

# Golden-export output. `nes_golden_export` writes these wherever `--out` points,
# and none of them belong in the tree: they are reproducible from a pinned
# commit, and a committed copy is a copy that drifts.
#
# The re-include below is not decoration. A BARE pattern matches at any depth,
# which is exactly how `Cargo.lock` silently ignored the excluded crate's
# lockfile until v2.4.2 -- so the committed golden trees are named explicitly,
# and a binary golden deliberately added there will not be swallowed.
*.ckpt.bin
*.obs.bin
*.boot.bin
*.index_fb.bin
*.ram.bin
*.manifest.txt
!/golden/**
!/crates/rustynes-test-harness/golden/**

# --- Native build & FFI artifacts ---
*.so
*.dylib
*.dll
*.exe
*.a
*.lib
*.pdb
# Apple debug symbols. The libretro Apple jobs (osx / ios / tvos) and the iOS
# xcframework build emit `<name>.dylib.dSYM` bundles next to the library, and
# the buildbot additionally zips them for upload — `*.dylib` above covers the
# library but neither the bundle directory nor the archive. Building any Apple
# libretro target locally (`crates/rustynes-libretro/Makefile`) leaves both in
# the working tree.
*.dSYM/
*.dSYM.zip

# --- WebAssembly / trunk / wasm-pack ---
/pkg/
/dist/
*.wasm
wasm-pack.log
# trunk build output (regenerated by `trunk build`; never committed).
/crates/rustynes-frontend/web/dist/
# v1.5.0 Workstream G — the Emscripten rcheevos→wasm side module
# (`scripts/cheevos/build_rcheevos_wasm.sh` output). The `.wasm` (above) +
# `.js` glue are build artifacts: rebuild on demand, never commit. The hand-
# written loader (`ra_glue.js`) + the dir's README ARE committed.
/crates/rustynes-frontend/web/cheevos/rcheevos.js

# --- Node.js (web frontend) ---
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Python (helper scripts under scripts/, icon generator under assets/) ---
__pycache__/
*.pyc
.venv/
venv/
# Icon generator default output dir (regenerated by make_icon.py).
/assets/RustyNES_Icon/out/

# --- Platform packages ---
*.AppImage
*.snap
*.flatpak
*.msi
*.appx
# insta reference snapshots also end in `.snap`; the ROM suites compare against
# these committed fixtures, so re-include them (overrides the Snapcraft `*.snap`).
!**/snapshots/**/*.snap
!**/snapshots/*.snap
# ...but insta's pending/rejected snapshots (`.snap.new`) are transient — accept
# them into `.snap` (`cargo insta accept`) or delete; never commit.
*.snap.new

# --- Fuzzing (commit the harnesses; ignore the build/corpus) ---
fuzz/
!/fuzz/
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
corpus/
artifacts/

# --- ROMs & media (copyright) ---
# The broad `*.nes`/`*.fds` rules ignore ALL ROMs; re-include the committable
# CC0 / public-domain suites under tests/roms/, then HARD-exclude the commercial
# dumps + the large fetched clone (NEVER committed — Nintendo copyright).
*.nes
*.fds
!/tests/roms/**/*.nes
/tests/roms/external/
/tests/roms/nes-test-roms/
/game-roms/

# coverage tool's cached library-header scan (developer-local; ~25k headers)
/scripts/coverage/.library-index.json
*.qd
*.nsf
*.nsfe
*.nsf2
# User-supplied palette files (v1.1.0 .pal loading) — none committed
*.pal
# ROM soft-patches (v1.2.0 ingest: auto-applied .ips/.ups/.bps beside a ROM).
# User-supplied, copyright-adjacent — never committed (mirrors the ROM policy).
*.ips
*.ups
*.bps

# --- TAS movie files (may contain copyrighted content) ---
*.rnm
*.rnmproj
*.rnmb
*.fm2
*.fm3
*.bk2
*.tasproj

# --- Save / state / input / dumps / cheats ---
*.rns
*.sav
*.srm
*.state
*.savestate
*.snapshot
*.quick*.state
*.rec
*.input
*.ram
*.dump
*.cht

# --- Game database files ---
*.db
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.dat
*.xml
!assets/**/*.xml
# v1.2.0 in-app ROM-Database editor writes a user overlay to the OS data dir;
# ignore a stray copy if the app is ever run from the repo root.
game_db_user.txt

# --- Logs / debug / test output ---
*.log
# Keep the kevtris nestest golden trace despite the broad *.log ignore.
!/tests/roms/nestest/nestest.log
*.test.log
*.golden
test-output/
/tests/captures/
/tests/framework/enhanced-validator/target/
/tests/framework/*.exe
/tests/framework/test_rom_validator

# --- Coverage / profiling ---
*.gcno
*.gcda
coverage/
# ...but NOT the committed coverage tooling (the `coverage/` rule above is for
# code-coverage artifact dirs; the cache JSON stays ignored via its rule above).
!/scripts/coverage/
!/scripts/coverage/**
/scripts/coverage/.library-index.json
/scripts/coverage/__pycache__/
tarpaulin-report.html
perf.data
perf.data.old
flamegraph.svg
/perf-logs/
# PGO / profile-guided-optimization artifacts (v1.2.0 pgo.yml + scripts/pgo/).
# The instrument/train profiles are regenerated by the recipe; never committed.
*.profraw
*.profdata
/pgo-data/
/target/pgo/

# --- Documentation (build output + local-only references) ---
/docs/_site/
# Engine-development audit history (the C1 IRQ saga, DMA investigations, the
# v2.0 promotion logs, ...) — kept locally, NOT in the public repo. The v1.0.0
# synthesis handoff lives at docs/v1.0.0-synthesis-handoff-*.md instead.
/docs/audit/
# Large local NESdev wiki mirror (~208M, reference only).
/nesdev_wiki/

# --- Reference projects (external cloned repos) — REFERENCE FIREWALL ---
# ref-proj/ held local clones of reference emulators used ONLY as black-box
# behavioral oracles. Their licenses are project-specific: Mesen2, puNES, FCEUX,
# and GeraNES are copyleft (GPL), and reproducing that source makes RustyNES a
# derivative work (which it now is, GPL-3.0-or-later); TriCNES is MIT. The
# directory has been REMOVED from disk and stays ignored here as a firewall guard
# so the copyleft source can never re-enter the working tree. Do NOT re-clone
# reference-emulator source into the repo; implement hardware behavior from
# docs/test ROMs. (The MIT TriCNES source is instead deliberately vendored, with
# attribution, under crates/rustynes-test-harness/golden/tricnes/.) See
# docs/ai-emulator-provenance-guardrails.md and the "MOST IMPORTANT RULE" of AGENTS.md.
/ref-proj/

# --- Temporary files ---
/tmp/
/temp/
*.tmp

# --- Merge / patch artifacts (git conflict + `git apply --reject` leftovers) ---
*.orig
*.rej

# --- Environment ---
.env
.env.local

# --- Editors ---
.idea/
.vscode/
.zed/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
._*
Thumbs.db
Desktop.ini

# --- Android (v1.8.0) ---
# The android/ Gradle module has its own .gitignore (build/, .gradle/, jniLibs/,
# keystore.properties, local.properties, the wrapper jar); these belt-and-suspenders
# rules cover the same outputs if a tool scans from the repo root. The committed
# Gradle wrapper (gradlew[.bat] + gradle-wrapper.jar) and keystore.properties.example
# are intentionally tracked.
android/**/build/
**/.gradle/
android/local.properties
# Release upload-signing secrets (v2.0.4 signing config: `rootProject.file(
# "keystore.properties")` or the `RUSTYNES_UPLOAD_*` env vars). Ignore the props
# file anywhere, plus any keystore blob — a maintainer secret, NEVER committed.
# The tracked `keystore.properties.example` template is intentionally kept.
keystore.properties
android/keystore.properties
*.jks
*.keystore
android/app/src/main/jniLibs/

# --- iOS (v1.9.0 "Sunrise") ---
# The xcframework + the UniFFI-generated Swift surface + the XcodeGen-generated
# Xcode project are all BUILD ARTIFACTS (regenerated by
# scripts/build-ios-xcframework.sh); never committed. The hand-written SwiftUI
# sources, project.yml, Info.plist, entitlements, PrivacyInfo, the bridging
# header, and ios/Generated/.gitkeep ARE tracked.
ios/RustyNESFFI.xcframework/
ios/Generated/RustyNESCore.swift
ios/RustyNES.xcodeproj/
ios/build/
*.ipa
# fastlane local output (the generated docs + the last-run report). The Play
# Console listing under `fastlane/metadata/` (v2.0.4 — title / descriptions /
# changelogs, en-US + es-ES) is version-controlled source and IS tracked; only the
# generated report / README / test output below are ignored.
fastlane/report.xml
fastlane/README.md
fastlane/test_output/

# --- Pre-commit ---
.pre-commit-cache/

# --- AI assistant local files ---
CLAUDE.local.md
/.claude/
WARP.md
/.warp/

# Local scratch / salvage working dir (data/docs/logs pulled from /tmp triage); not
# part of the repo.
/salvaged/

# NOTE: BestEffort boot-smoke ROMs (homebrew/unlicensed/multicart) are no longer
# a separate tree — they live under the already-ignored tests/roms/external/
# alongside every other staged dump (the coverage harness discovers ONE external/
# ROM tree; only the *screenshots* are tier-split, into screenshots/besteffort/).

# --- Wiki (Separate Repo) ---
# RustyNES.wiki/ is a standalone clone of the GitHub Wiki repo
# (github.com/doublegate/RustyNES.wiki.git) checked out inside this tree to
# author/build the wiki; it carries its own .git and must never be committed
# into the main repository.
/RustyNES.wiki/

# Game Genie header-robust re-key: NES 2.0 DB is a build-time input, never committed
scripts/gg/nes20db.xml
scripts/gg/__pycache__/

# Antigravity PR reviewer: scratch workspace for the on-disk diff handoff. When a PR's
# diff is too large to inline in the prompt, scripts/agy-review.sh writes it here so agy
# can READ it with its file tools instead of the review being truncated to the argv
# ceiling. Created and removed within a single run; never committed.
/.agy-review-work/
